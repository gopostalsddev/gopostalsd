#!/bin/bash
. /usr/local/lib/gopostal-rehearsal/gopostal-common.inc
no_args "$@"
assert_boundary

compose ps
compose exec -T db sh -eu -c 'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
compose exec -T web python -c \
  "import urllib.request; response=urllib.request.urlopen('http://127.0.0.1:5000/health/ready', timeout=3); assert response.status == 200"
curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8510/health/ready >/dev/null
curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8511/ >/dev/null
curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8511/health/ready >/dev/null
status=$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 5 \
  -H 'Content-Type: application/json' -d '{}' http://127.0.0.1:8510/api/auth/login)
case "$status" in
  400|401|422|429) ;;
  *) printf 'unexpected login endpoint response: HTTP %s\n' "$status" >&2; exit 1 ;;
esac
printf 'GoPostal fixed local acceptance probes passed\n'
